generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id        String   @id
  fullName  String?  @map("full_name")
  email     String?
  avatarUrl String?  @map("avatar_url")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("profiles")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  title     String
  message   String
  projectId String?  @map("project_id")
  taskId    String?  @map("task_id")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model Organization {
  id                     String       @id @default(cuid())
  name                   String
  slug                   String       @unique
  logo                   String?
  timezone               String       @default("Europe/Paris")
  plan                   OrgPlan      @default(FREE)
  stripeCustomerId       String?      @unique @map("stripe_customer_id")
  stripeSubscriptionId   String?      @unique @map("stripe_subscription_id")
  stripeSubscriptionStatus String?    @map("stripe_subscription_status")
  trialEndsAt            DateTime?    @map("trial_ends_at")
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  members         OrganizationMember[]
  invites         InviteToken[]
  smtpConfig      SmtpConfig?
  permissionRules PermissionRule[]
  milestoneTypes  MilestoneType[]
  githubConnection GithubConnection?

  @@map("organizations")
}

enum OrgPlan {
  FREE
  TRIAL
  PRO
  BUSINESS
}

enum OrgRole {
  ADMIN
  MEMBRE
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(MEMBRE)
  joinedAt       DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model InviteToken {
  id          String            @id @default(cuid())
  organizationId String
  email       String
  orgRole     OrgRole           @default(MEMBRE)
  projectRole ProjectMemberRole @default(OBSERVATEUR)
  allProjects Boolean           @default(false)
  projectIds  String[]          @default([])
  message     String?
  createdBy   String
  token       String            @unique @default(cuid())
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invite_tokens")
}

model SmtpConfig {
  id             String   @id @default(cuid())
  organizationId String   @unique
  host           String
  port           Int      @default(587)
  secure         Boolean  @default(false)
  user           String
  password       String
  fromEmail      String
  fromName       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("smtp_configs")
}

enum ProjectStatus {
  INITIALISATION
  EN_COURS
  EN_ATTENTE
  CRITIQUE
  TERMINE
  ARCHIVE
}

enum ProjectMemberRole {
  CO_RESPONSABLE
  CONTRIBUTEUR
  OBSERVATEUR
}

enum CustomFieldType {
  TEXT_COURT
  TEXT_LONG
  NOMBRE
  DATE
  BOOLEEN
  LISTE
  UTILISATEUR
}

model Project {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         ProjectStatus @default(INITIALISATION)
  startDate      DateTime?
  endDate        DateTime?
  category       String?
  color          String        @default("#1D3461")
  managerId      String
  createdBy      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  archivedAt     DateTime?

  members        ProjectMember[]
  customFields   ProjectCustomField[]
  depsAsSource   ProjectDependency[] @relation("SourceProject")
  depsAsTarget   ProjectDependency[] @relation("TargetProject")

  @@map("projects")
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMemberRole @default(CONTRIBUTEUR)
  joinedAt  DateTime          @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model ProjectCustomField {
  id             String          @id @default(cuid())
  projectId      String?
  organizationId String?
  name           String
  type           CustomFieldType
  options        Json?
  isTemplate     Boolean         @default(false)
  order          Int             @default(0)

  project        Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_custom_fields")
}

enum TaskStatus {
  A_FAIRE
  EN_COURS
  EN_REVUE
  TERMINE
  BLOQUE
}

enum TaskPriority {
  BASSE
  NORMALE
  HAUTE
  CRITIQUE
}

enum DependencyType {
  FIN_DEBUT
  DEBUT_DEBUT
  FIN_FIN
  DEBUT_FIN
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  parentId    String?
  milestoneId String?      @map("milestone_id")
  title       String
  shortName   String?      @map("short_name") @db.VarChar(6)
  description String?
  status      TaskStatus   @default(A_FAIRE)
  priority    TaskPriority @default(NORMALE)
  assigneeId  String?
  startDate   DateTime?
  dueDate     DateTime?
  estimatedTime Int?       @map("estimated_time")
  timeSpent     Int?       @map("time_spent")
  order             Int          @default(0)
  level             Int          @default(0)
  githubIssueNumber Int?         @map("github_issue_number")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  parent      Task?   @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Task[]  @relation("TaskHierarchy")
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  dependsOn   TaskDependency[] @relation("DependentTask")
  blockedBy   TaskDependency[] @relation("BlockingTask")
  deliverables Deliverable[]

  @@map("tasks")
}

model TaskDependency {
  id              String         @id @default(cuid())
  dependentTaskId String
  blockingTaskId  String
  type            DependencyType @default(FIN_DEBUT)
  lagDays         Int            @default(0)

  dependentTask   Task @relation("DependentTask", fields: [dependentTaskId], references: [id], onDelete: Cascade)
  blockingTask    Task @relation("BlockingTask", fields: [blockingTaskId], references: [id], onDelete: Cascade)

  @@unique([dependentTaskId, blockingTaskId])
  @@map("task_dependencies")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("task_comments")
}

enum MilestoneStatus {
  A_VENIR
  ATTEINT
  MANQUE
  REPORTE
}

enum DeliverableStatus {
  A_FAIRE
  EN_COURS
  LIVRE
  VALIDE
  REJETE
}

enum ObjectiveStatus {
  PREVU
  EN_COURS
  ATTEINT
  ABANDONNE
}

model MilestoneType {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  color          String      @default("#6366f1")
  icon           String      @default("milestone")
  description    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  milestones     Milestone[]

  @@map("milestone_types")
}

model Milestone {
  id            String          @id @default(cuid())
  projectId     String
  typeId        String?
  title         String
  shortName     String?         @map("short_name") @db.VarChar(6)
  description   String?
  color         String?
  icon          String?
  plannedDate   DateTime
  actualDate    DateTime?
  status        MilestoneStatus @default(A_VENIR)
  showOnGantt   Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  type          MilestoneType?  @relation(fields: [typeId], references: [id], onDelete: SetNull)
  deliverables  Deliverable[]
  tasks         Task[]

  @@map("milestones")
}

model Deliverable {
  id           String            @id @default(cuid())
  projectId    String
  milestoneId  String?
  taskId       String?           @map("task_id")
  title        String
  description  String?
  responsibleId String?
  plannedDate  DateTime?
  status       DeliverableStatus @default(A_FAIRE)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  milestone    Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  task         Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@map("deliverables")
}

model ProjectObjective {
  id               String          @id @default(cuid())
  projectId        String
  title            String
  successIndicator String?
  status           ObjectiveStatus @default(PREVU)
  order            Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("project_objectives")
}

enum RiskProbability {
  FAIBLE
  MOYEN
  ELEVE
}

enum RiskImpact {
  FAIBLE
  MOYEN
  ELEVE
}

enum RiskStatus {
  OUVERT
  EN_COURS
  RESOLU
  ACCEPTE
}

model ProjectRisk {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  description String?
  probability RiskProbability @default(MOYEN)
  impact      RiskImpact      @default(MOYEN)
  status      RiskStatus      @default(OUVERT)
  mitigation  String?
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("project_risks")
}

model ProjectDocument {
  id           String   @id @default(cuid())
  projectId    String
  name         String
  storagePath  String
  mimeType     String?
  size         Int?
  uploadedBy   String
  createdAt    DateTime @default(now())

  @@map("project_documents")
}

model PermissionRule {
  id             String   @id @default(cuid())
  organizationId String
  role           String
  action         String
  allowed        Boolean

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role, action])
  @@map("permission_rules")
}

enum DependableType {
  TACHE
  JALON
  LIVRABLE
}

enum ProjectLinkType {
  SUCCESSION
  BLOQUE
  LIE
}

model Dependency {
  id         String         @id @default(cuid())
  sourceType DependableType
  sourceId   String
  targetType DependableType
  targetId   String
  type       DependencyType @default(FIN_DEBUT)
  lagDays    Int            @default(0)
  createdAt  DateTime       @default(now())

  @@unique([sourceType, sourceId, targetType, targetId])
  @@map("dependencies")
}

model GithubConnection {
  id             String   @id @default(cuid())
  organizationId String   @unique @map("organization_id")
  repoOwner      String   @map("repo_owner")
  repoName       String   @map("repo_name")
  webhookSecret  String   @map("webhook_secret")
  accessToken    String?  @map("access_token")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("github_connections")
}

model ProjectDependency {
  id              String          @id @default(cuid())
  sourceProjectId String
  targetProjectId String
  type            ProjectLinkType @default(SUCCESSION)
  lagDays         Int             @default(0)
  createdAt       DateTime        @default(now())

  sourceProject   Project @relation("SourceProject", fields: [sourceProjectId], references: [id], onDelete: Cascade)
  targetProject   Project @relation("TargetProject", fields: [targetProjectId], references: [id], onDelete: Cascade)

  @@unique([sourceProjectId, targetProjectId])
  @@map("project_dependencies")
}
